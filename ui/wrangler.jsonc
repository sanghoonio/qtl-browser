// Cloudflare Workers static-assets deploy. Workers Builds: root directory `ui`, build command
// `npm run build`, deploy command `npx wrangler deploy`. The SPA fallback for /gene/... paths
// is `not_found_handling`; a `public/_redirects` with `/* /index.html 200` is rejected by
// Workers as a redirect loop, so there is none.
{
  "name": "qtl-browser",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
